{
  "name": "prit/laravel-10-full",
  "description": "Full Laravel 10 project skeleton for CI/CD (run composer install after download)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "laravel/framework": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "test": "phpunit"
  }
}